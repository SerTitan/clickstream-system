{
  "title": "Clickstream System Monitoring",
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 3,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 100,
      "type": "row",
      "title": "API Performance",
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 1 },
      "collapsed": false
    },
    {
      "id": 1,
      "type": "timeseries",
      "title": "API RPS (requests/sec)",
      "description": "Rate of HTTP requests to the API",
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "gridPos": { "x": 0, "y": 1, "w": 8, "h": 7 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": { "mode": "palette-classic" }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_requests_total{job=\"api\"}[$__rate_interval]))",
          "legendFormat": "Total RPS"
        },
        {
          "refId": "B",
          "expr": "sum by (path) (rate(http_requests_total{job=\"api\"}[$__rate_interval]))",
          "legendFormat": "{{path}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "API Response Time (latency)",
      "description": "Request latency percentiles",
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "gridPos": { "x": 8, "y": 1, "w": 8, "h": 7 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": { "mode": "palette-classic" }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"api\"}[$__rate_interval])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"api\"}[$__rate_interval])))",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"api\"}[$__rate_interval])))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "API HTTP Status Codes",
      "description": "Requests by HTTP status code",
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "gridPos": { "x": 16, "y": 1, "w": 8, "h": 7 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": { "mode": "palette-classic" }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (rate(http_requests_total{job=\"api\"}[$__rate_interval]))",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 101,
      "type": "row",
      "title": "System Health",
      "gridPos": { "x": 0, "y": 8, "w": 24, "h": 1 },
      "collapsed": false
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Services Status",
      "description": "Health of system components (1 = UP, 0 = DOWN)",
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "gridPos": { "x": 0, "y": 9, "w": 12, "h": 5 },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "textMode": "value_and_name",
        "colorMode": "background"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" } } },
            { "type": "value", "options": { "1": { "text": "UP", "color": "green" } } }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "red" },
              { "value": 1, "color": "green" }
            ]
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=~\"api|kafka|clickhouse|cadvisor|prometheus\"}",
          "legendFormat": "{{job}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "HTTP Health Probes",
      "description": "Blackbox probe results (1 = success)",
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "gridPos": { "x": 12, "y": 9, "w": 12, "h": 5 },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "textMode": "value_and_name",
        "colorMode": "background"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "FAIL", "color": "red" } } },
            { "type": "value", "options": { "1": { "text": "OK", "color": "green" } } }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "red" },
              { "value": 1, "color": "green" }
            ]
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "probe_success{job=\"blackbox_http\"}",
          "legendFormat": "{{instance}}"
        }
      ]
    },
    {
      "id": 102,
      "type": "row",
      "title": "Resource Usage",
      "gridPos": { "x": 0, "y": 14, "w": 24, "h": 1 },
      "collapsed": false
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Docker Total CPU Usage",
      "description": "Total CPU usage for all Docker containers",
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "gridPos": { "x": 0, "y": 15, "w": 12, "h": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "color": { "mode": "palette-classic" }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(container_cpu_usage_seconds_total{id=\"/docker\"}[$__rate_interval]))",
          "legendFormat": "Docker Total CPU"
        },
        {
          "refId": "B",
          "expr": "sum(rate(container_cpu_usage_seconds_total{id=\"/\"}[$__rate_interval]))",
          "legendFormat": "Host Total CPU"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Docker Total Memory Usage",
      "description": "Total memory usage for Docker (WSL2 cgroups limitation)",
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "gridPos": { "x": 12, "y": 15, "w": 12, "h": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0,
          "color": { "mode": "palette-classic" }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "container_memory_usage_bytes{id=\"/docker\"}",
          "legendFormat": "Docker Memory"
        },
        {
          "refId": "B",
          "expr": "container_memory_usage_bytes{id=\"/\"}",
          "legendFormat": "Host Memory"
        }
      ]
    },
    {
      "id": 103,
      "type": "row",
      "title": "ClickHouse Resource Usage",
      "gridPos": { "x": 0, "y": 23, "w": 24, "h": 1 },
      "collapsed": false
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "ClickHouse Memory Usage",
      "description": "ClickHouse memory tracking metrics",
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "gridPos": { "x": 0, "y": 24, "w": 12, "h": 7 },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "color": { "mode": "palette-classic" }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "clickhouse_memory_tracking",
          "legendFormat": "Memory Tracking"
        },
        {
          "refId": "B",
          "expr": "clickhouse_memory_tracking_in_background_move_processing_pool",
          "legendFormat": "Background Move Pool"
        },
        {
          "refId": "C",
          "expr": "clickhouse_memory_tracking_in_background_schedule_pool",
          "legendFormat": "Background Schedule Pool"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "ClickHouse Query Activity",
      "description": "Active queries and connections",
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "gridPos": { "x": 12, "y": 24, "w": 12, "h": 7 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "palette-classic" }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "clickhouse_query",
          "legendFormat": "Active Queries"
        },
        {
          "refId": "B",
          "expr": "clickhouse_tcp_connection",
          "legendFormat": "TCP Connections"
        },
        {
          "refId": "C",
          "expr": "clickhouse_http_connection",
          "legendFormat": "HTTP Connections"
        }
      ]
    },
    {
      "id": 104,
      "type": "row",
      "title": "Kafka & ClickHouse",
      "gridPos": { "x": 0, "y": 31, "w": 24, "h": 1 },
      "collapsed": false
    },
    {
      "id": 10,
      "type": "stat",
      "title": "Kafka Cluster Status",
      "description": "Kafka brokers and topic partitions",
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "gridPos": { "x": 0, "y": 32, "w": 8, "h": 7 },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "textMode": "value_and_name",
        "colorMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "green" }
            ]
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "kafka_brokers",
          "legendFormat": "Brokers"
        },
        {
          "refId": "B",
          "expr": "kafka_topic_partitions{topic=\"clickstream-events-raw\"}",
          "legendFormat": "Topic Partitions"
        },
        {
          "refId": "C",
          "expr": "sum(kafka_topic_partition_in_sync_replica{topic=\"clickstream-events-raw\"})",
          "legendFormat": "In-Sync Replicas"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Kafka Consumer Lag",
      "description": "Consumer group lag for clickstream topic",
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "gridPos": { "x": 8, "y": 32, "w": 8, "h": 7 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "palette-classic" }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "kafka_consumergroup_lag_sum{consumergroup=\"ch_raw_ingest\",topic=\"clickstream-events-raw\"}",
          "legendFormat": "Total Lag"
        },
        {
          "refId": "B",
          "expr": "kafka_consumergroup_lag{consumergroup=\"ch_raw_ingest\",topic=\"clickstream-events-raw\"}",
          "legendFormat": "Partition {{partition}}"
        }
      ]
    },
    {
      "id": 12,
      "type": "stat",
      "title": "ClickHouse Metrics",
      "description": "Key ClickHouse metrics",
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "gridPos": { "x": 16, "y": 32, "w": 8, "h": 7 },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "orientation": "vertical",
        "textMode": "value_and_name",
        "colorMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "green" }
            ]
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "clickhouse_query",
          "legendFormat": "Active Queries"
        },
        {
          "refId": "B",
          "expr": "clickhouse_attached_table",
          "legendFormat": "Tables"
        },
        {
          "refId": "C",
          "expr": "clickhouse_attached_database",
          "legendFormat": "Databases"
        },
        {
          "refId": "D",
          "expr": "clickhouse_up",
          "legendFormat": "ClickHouse Up"
        }
      ]
    },
    {
      "id": 105,
      "type": "row",
      "title": "API In-Flight & Errors",
      "gridPos": { "x": 0, "y": 39, "w": 24, "h": 1 },
      "collapsed": false
    },
    {
      "id": 13,
      "type": "gauge",
      "title": "API In-Flight Requests",
      "description": "Current requests being processed",
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "gridPos": { "x": 0, "y": 40, "w": 8, "h": 6 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "green" },
              { "value": 50, "color": "yellow" },
              { "value": 80, "color": "red" }
            ]
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "http_in_flight_requests{job=\"api\"}",
          "legendFormat": "In-Flight"
        }
      ]
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "API Error Rate",
      "description": "Rate of 4xx and 5xx errors",
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "gridPos": { "x": 8, "y": 40, "w": 8, "h": 6 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": { "mode": "palette-classic" }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_requests_total{job=\"api\", status=~\"4..\"}[$__rate_interval]))",
          "legendFormat": "4xx errors"
        },
        {
          "refId": "B",
          "expr": "sum(rate(http_requests_total{job=\"api\", status=~\"5..\"}[$__rate_interval]))",
          "legendFormat": "5xx errors"
        }
      ]
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "HTTP Probe Latency",
      "description": "Latency of blackbox health probes",
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "gridPos": { "x": 16, "y": 40, "w": 8, "h": 6 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": { "mode": "palette-classic" }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "probe_duration_seconds{job=\"blackbox_http\"}",
          "legendFormat": "{{instance}}"
        }
      ]
    }
  ]
}
